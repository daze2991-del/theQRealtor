NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
PHONE_VERIFY_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
ANTHROPIC_API_KEY=

# ── Billing ───────────────────────────────────────────────────────────────────
# Production billing is MANUAL. All switches below are independent and all
# must be on before billing is live end-to-end. Leave them unset/false.

# Master kill switch for Stripe-driven entitlement writes. Checked server-side
# in lib/billing.ts. Fails closed: only the exact string 'true' enables it.
# While unset/false the webhook verifies signatures and logs events but writes
# no entitlement change of any kind.
BILLING_AUTOMATION_ENABLED=false

# Gates /api/stripe/checkout and /api/stripe/portal (pre-existing switch).
STRIPE_CHARGES_ENABLED=false

# Whether the billing page renders tier cards/checkout buttons at all, and a
# second gate the checkout route itself checks server-side (app/dashboard/
# billing/page.tsx reads this via force-dynamic so a flip takes effect without
# a redeploy). Independent of STRIPE_CHARGES_ENABLED — both must be true
# before a real checkout session can be created.
PAID_PLANS_ENABLED=false

# Gates whether interval:'year' is accepted by /api/stripe/checkout. Monthly
# billing works regardless of this flag; annual is inert until it's true.
ANNUAL_BILLING_ENABLED=false

# Stripe credentials. Use TEST-mode keys (sk_test_… / whsec_… from `stripe
# listen` or a test-mode endpoint) until production billing is authorized.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Per-tier Price IDs, read by lib/pricing.ts at request time (never cached at
# module load). No fallback exists between tiers or intervals — a missing var
# here is a 500 config error, not a silent substitution. Create these in the
# Stripe dashboard in TEST mode until production billing is authorized:
#   Starter Monthly $39   Starter Yearly $390
#   Pro     Monthly $79   Pro     Yearly $790
STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_STARTER_YEARLY=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=

# ── Open self-service signup ─────────────────────────────────────────────────
# Unset/false (DEFAULT): signup is invite-only — an email must have an approved
# row in beta_allowlist. Exactly today's behavior.
# 'true': skips ONLY the allowlist gate, turning /api/auth/beta-signup into real
# self-service registration. Every other guard still applies — phone format,
# server-side phone-verification token, phone uniqueness, and the 25-agent hard
# cap (lib/signup.ts MAX_ENROLLED_AGENTS), which is enforced on both paths.
# New accounts get plan='trial' on every path, same as today.
# Fails closed: only the exact string 'true' opens signup.
# Independent of the billing switches — this creates accounts, never charges.
OPEN_SIGNUP_ENABLED=
