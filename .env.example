NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
PHONE_VERIFY_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
ANTHROPIC_API_KEY=

# ── Billing ───────────────────────────────────────────────────────────────────
# Production billing is MANUAL. All three switches below are independent and all
# must be on before billing is live end-to-end. Leave them unset/false.

# Master kill switch for Stripe-driven entitlement writes. Checked server-side
# in lib/billing.ts. Fails closed: only the exact string 'true' enables it.
# While unset/false the webhook verifies signatures and logs events but writes
# no entitlement change of any kind.
BILLING_AUTOMATION_ENABLED=false

# Gates /api/stripe/checkout and /api/stripe/portal (pre-existing switch).
STRIPE_CHARGES_ENABLED=false

# Stripe credentials. Use TEST-mode keys (sk_test_… / whsec_… from `stripe
# listen` or a test-mode endpoint) until production billing is authorized.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# TEST-mode Price IDs. Create these in the Stripe dashboard in TEST mode:
#   Starter Monthly $39   Starter Annual $390
#   Pro     Monthly $79   Pro     Annual $790
STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_STARTER_ANNUAL=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=

# Legacy single-tier price vars still read by /api/stripe/checkout.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
